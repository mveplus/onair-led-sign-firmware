# --- AWS IoT credentials --------------------------------------------------
# Per-device certs and keys produced by scripts/provision-device.sh.
# Never commit these.
certs/

# Compile-time AWS IoT secrets header — generated per build/device.
secrets.h
src/secrets.h

# Belt-and-suspenders: any PEM / key / cert that escapes certs/
*.pem
*.key
*.crt

# --- Local toolchain noise ------------------------------------------------
.DS_Store
*.swp
*.swo

# --- Arduino / ESP-IDF intermediate build outputs --------------------------
# Binaries can embed compile-time secrets if anyone ever builds with a
# populated secrets.h, so we keep them out of git entirely. Tagged
# releases publish artifacts via GitHub Releases instead.
build/*.bin
build/*.elf
build/*.map
build/onair-led-sign-firmware.ino*
build/onair-led-sign-firmware/
